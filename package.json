{
  "name": "blockworld-web",
  "version": "0.59.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node server/server.js",
    "build": "vite build",
    "test": "node --test src/*.test.js",
    "setup:bridge": "python3 tools/setup_bridge.py",
    "test:bridge": "python3 -m unittest discover -s tools -p 'test_memory_bridge.py'",
    "push:github": "node tools/push-github.mjs",
    "agent:codex": "node tools/start-codex.mjs",
    "agent:claude": "claude",
    "music:fetch": "node tools/fetch-music-streams.mjs",
    "lang:fetch": "node tools/fetch-lang.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
